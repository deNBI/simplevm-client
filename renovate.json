{
  "extends": [
    "config:best-practices",
    "helpers:pinGitHubActionDigests"
  ],
  "osvVulnerabilityAlerts": true,
  "packageRules": [
    {
      "matchUpdateTypes": [
        "major"
      ],
      "addLabels": [
        "major"
      ]
    },
    {
      "matchUpdateTypes": [
        "minor"
      ],
      "addLabels": [
        "minor"
      ]
    },
    {
      "matchUpdateTypes": [
        "patch"
      ],
      "addLabels": [
        "patch"
      ]
    },
    {
      "matchUpdateTypes": [
        "pin"
      ],
      "addLabels": [
        "pin"
      ]
    },
    {
      "matchLabels": [
        "security"
      ],
      "minimumReleaseAge": null
    }
  ],
  "pre-commit": {
    "enabled": true
  },
  "baseBranchPatterns": [
    "dev"
  ],
  "reviewers": [
    "team:portal-dev"
  ],
  "labels": [
    "dependencies"
  ],
  "assignees": [
    "team:portal-dev"
  ],
  "vulnerabilityAlerts": {
    "labels": [
      "security"
    ]
  },
  "branchPrefix": "deps/",
  "bumpVersion": "minor",
  "commitBodyTable": true,
  "commitMessagePrefix": "feat(Dependencies):",
  "minimumReleaseAge": "3 days"
}